# Optional overrides for `npm run devLocal`. Copy this file to .env.local
# (it is git-ignored) and uncomment what you need.
#
# By default the dev client talks to the game server on the same host as the
# page, on port 4040. That already works from phones on the same Wi-Fi
# (open http://<computer-ip>:3000), so most people need nothing here.

# Game server on another port:
# REACT_APP_SERVER_PORT=4040

# Game server on another machine:
# REACT_APP_SERVER_ADDRESS=192.168.1.17:4040
# REACT_APP_SERVER_ADDRESS_HTTP=http://192.168.1.17:4040
# REACT_APP_WEBSOCKET_HEADER=ws://
